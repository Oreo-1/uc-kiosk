pipeline {
    agent any
    
    options {
        disableConcurrentBuilds()
        timeout(time: 30, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '10'))
    }
    
    environment {
        DEPLOY_PATH = '/var/www/orderhere-backend'
        COMPOSER_HOME = '/tmp/composer'
        COMPOSER_ALLOW_SUPERUSER = '1'
    }
    
    stages {
        stage('Sync Code ke Deployment Folder') {
            steps {
                echo 'Syncing code ke deployment folder...'
                sh """
                    mkdir -p ${DEPLOY_PATH}
                    mkdir -p ${COMPOSER_HOME}
                    rsync -av --exclude='.git' --exclude='node_modules' --exclude='vendor' ./ ${DEPLOY_PATH}/
                    echo 'Code synced successfully!'
                """
            }
        }
        
        stage('Install Dependencies') {
            steps {
                echo 'Installing Composer dependencies...'
                dir("${DEPLOY_PATH}") {
                    sh 'composer install --no-dev --optimize-autoloader --no-interaction'
                }
            }
        }
        
        stage('Clear Cache') {
            steps {
                echo 'Clearing Laravel cache...'
                dir("${DEPLOY_PATH}") {
                    sh '''
                        php artisan config:clear
                        php artisan route:clear
                        php artisan cache:clear
                        php artisan view:clear
                    '''
                }
            }
        }
        
        stage('Run Migrations') {
            steps {
                echo 'Running database migrations...'
                dir("${DEPLOY_PATH}") {
                    sh 'php artisan migrate --force'
                }
            }
        }
        
        stage('Optimize Application') {
            steps {
                echo 'Optimizing Laravel...'
                dir("${DEPLOY_PATH}") {
                    sh '''
                        php artisan config:cache
                        php artisan route:cache
                        php artisan view:cache
                    '''
                }
            }
        }
        
        stage('Set Permissions') {
            steps {
                echo 'Setting file permissions...'
                sh """
                    chmod -R 775 ${DEPLOY_PATH}/storage ${DEPLOY_PATH}/bootstrap/cache
                    chown -R www-data:www-data ${DEPLOY_PATH}/storage ${DEPLOY_PATH}/bootstrap/cache 2>/dev/null || true
                """
            }
        }
    }
    
    post {
        success {
            echo 'Deploy BERHASIL!'
        }
        failure {
            echo 'Deploy GAGAL! Cek log untuk detail.'
        }
    }
}